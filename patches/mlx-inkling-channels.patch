diff --git a/mlx_lm/tool_parsers/inkling2.py b/mlx_lm/tool_parsers/inkling2.py
new file mode 100644
index 0000000..9cfcb36
--- /dev/null
+++ b/mlx_lm/tool_parsers/inkling2.py
@@ -0,0 +1,10 @@
+import json
+
+tool_call_start = "<|content_invoke_tool_json|>"
+tool_call_end = "<|end_message|>"
+
+def parse_tool_call(text, tools=None):
+    value = json.loads(text.strip())
+    if not isinstance(value.get("name"), str) or not isinstance(value.get("args"), dict):
+        raise ValueError("Invalid Inkling tool call")
+    return {"name": value["name"], "arguments": value["args"]}
